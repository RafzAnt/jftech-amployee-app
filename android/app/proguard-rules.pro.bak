# JFTECH ProGuard rules
# Keep mobile_scanner and ML Kit classes

-keep class com.google.mlkit.** { *; }
-keep class com.google.android.gms.** { *; }
-keep class com.google.android.gms.vision.** { *; }
-keep class com.google.android.gms.vision.barcode.** { *; }
-keep class com.google.android.gms.vision.barcode.Barcode.** { *; }

-dontwarn com.google.mlkit.**
-dontwarn com.google.android.gms.**
-dontwarn com.google.android.gms.vision.**
-dontwarn com.google.android.gms.vision.barcode.**

-keep class dev.fluttercommunity.plus.camera.** { *; }
-keep class io.flutter.plugins.camera.** { *; }

-keep class dev.flutter.plugin.android.** { *; }
-keep class io.flutter.embedding.android.** { *; }

# Keep mobile_scanner native classes
-keep class com.leilessan.scanner.** { *; }
-keep class com.leilessan.scanner.camera.** { *; }
-keep class com.leilessan.scanner.barcode.** { *; }

-dontwarn com.leilessan.scanner.**
-dontwarn com.leilessan.scanner.camera.**
-dontwarn com.leilessan.scanner.barcode.**
